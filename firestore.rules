rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isRootOwner() {
      return isAuthenticated() && (
        request.auth.token.role == 'root_owner' ||
        request.auth.token.rootOwner == true ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'root_owner')
      );
    }
    
    function isDirector() {
      return isAuthenticated() && (
        isRootOwner() ||
        request.auth.token.role == 'director' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'director')
      );
    }

    function isAdmin() {
      return isAuthenticated() && (
        isDirector() ||
        request.auth.token.admin == true || 
        request.auth.token.role == 'admin' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isTeacher() {
      return isAuthenticated() && (
        isAdmin() ||
        request.auth.token.role == 'teacher' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher')
      );
    }

    // 1. Users
    match /users/{userId} {
      // Root Owner profile cannot be read by ordinary users, teachers, or directors.
      // Only the root owner themselves or an authenticated root owner can read it.
      allow read: if isAuthenticated() && (
        resource.data.role != 'root_owner' || isRootOwner() || (request.auth.uid == userId)
      );
      // No client can self-assign root_owner role unless caller isRootOwner()
      allow create: if isAuthenticated() && (
        request.resource.data.role != 'root_owner' || isRootOwner()
      );
      // Root Owner cannot be modified or downgraded by non-root-owners
      // No ordinary user or director can promote an account to root_owner
      allow update: if isAuthenticated() && (
        (resource.data.role != 'root_owner' || isRootOwner() || (request.auth.uid == userId && request.resource.data.role == resource.data.role)) &&
        (request.resource.data.role != 'root_owner' || isRootOwner())
      );
      // Root Owner cannot be deleted by admins or directors; only by Root Owner
      allow delete: if (isAdmin() && resource.data.role != 'root_owner') || isRootOwner();
    }

    // 2. User Progress
    match /user_progress/{progressId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // 3. Subjects
    match /subjects/{subjectId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 4. Levels
    match /levels/{levelId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 5. Questions
    match /questions/{questionId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // 6. Test Sessions
    match /test_sessions/{sessionId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // 7. Coin Transactions
    match /coin_transactions/{transactionId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // 8. Products
    match /products/{productId} {
      allow read: if true;
      allow create: if isAdmin();
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // 9. Orders
    match /orders/{orderId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // 10. Question Submissions
    match /question_submissions/{submissionId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // 11. Weekly Rewards
    match /weekly_rewards/{rewardId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // 12. Reviews
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // 13. Leaderboard Stats
    match /leaderboard_stats/{boardType} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // 14. Notifications
    match /notifications/{notificationId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // 15. Audit Logs
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // 15b. Protected Root Audit Logs (Exclusive to Root Owner)
    match /root_audit_logs/{logId} {
      allow read, write: if isRootOwner();
    }

    // 16. System Settings
    match /system_settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 17. LMS Groups
    match /groups/{groupId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // 18. LMS Lessons
    match /lessons/{lessonId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin() || isTeacher() || (isAuthenticated() && resource.data.teacherId == request.auth.uid);
    }

    // 19. LMS Homeworks
    match /homeworks/{homeworkId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // 20. LMS Homework Submissions
    match /homework_submissions/{submissionId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // 21. LMS Attendance
    match /attendance/{attendanceId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isTeacher();
    }

    // 22. LMS Teacher Questions
    match /teacher_questions/{questionId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // 23. ERP Payments
    match /payments/{paymentId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // 24. ERP Expenses
    match /expenses/{expenseId} {
      allow read, write: if isAdmin();
    }

    // 25. ERP Teacher Salaries
    match /teacher_salaries/{salaryId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // 26. LMS Admissions
    match /admissions/{admissionId} {
      allow read, write: if isAuthenticated();
    }
  }
}